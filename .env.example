# SecurePay YUI — three-world configuration
#
# Market is the default world. Trainer and Game are isolated by route namespace
# (/trainer/* and /game/*) and securePayFetch blocks live API calls from those
# simulated worlds at request time.

# Legacy Explorer compatibility is opt-in only. Leave false for the canonical
# three-world application.
VITE_SECUREPAY_EXPLORER_MODE=false

# Configure the real SecurePayAPI URL in an environment that is intended to
# connect to Market authority. When blank, Market pages fail safely rather than
# inventing backend truth.
VITE_SECUREPAY_API_BASE_URL=
VITE_SECUREPAY_API_MODE=staging

# Money actions remain false unless separately certified and backend-approved.
VITE_SECUREPAY_ENABLE_MONEY_ACTIONS=false
VITE_SECUREPAY_ENABLE_RELEASE_ACTIONS=false
VITE_SECUREPAY_ENABLE_PAYMENT_CONFIRMATION=false
VITE_SECUREPAY_ENABLE_WITHDRAWAL_ACTIONS=false
VITE_SECUREPAY_ENABLE_PAYOUT_ACTIONS=false
VITE_SECUREPAY_ENABLE_LEDGER_ACTIONS=false

# Dedicated Trainer/Game routes do not require a separate environment flag.
# Even if the Market API is configured, live API calls are rejected while the
# current browser path belongs to Trainer, Game, preview, review, legacy
# /explore or legacy /play.
