# SecurePay YUI v1 — Explorer / Training configuration
# This baseline intentionally runs without authentication or live money.
# The API client is hard-blocked while Explorer mode is true.

VITE_SECUREPAY_EXPLORER_MODE=true
VITE_SECUREPAY_API_BASE_URL=
VITE_SECUREPAY_API_MODE=mock

# Money actions remain false. Explorer mode also forces them false in code.
VITE_SECUREPAY_ENABLE_MONEY_ACTIONS=false
VITE_SECUREPAY_ENABLE_RELEASE_ACTIONS=false
VITE_SECUREPAY_ENABLE_PAYMENT_CONFIRMATION=false
VITE_SECUREPAY_ENABLE_WITHDRAWAL_ACTIONS=false
VITE_SECUREPAY_ENABLE_PAYOUT_ACTIONS=false
VITE_SECUREPAY_ENABLE_LEDGER_ACTIONS=false

# Future production integration:
# 1. connect/test SecurePayAPI and real authentication;
# 2. keep all money action flags backend-controlled;
# 3. set VITE_SECUREPAY_EXPLORER_MODE=false only in the certified production build.
# The Explorer build can remain deployed separately for training/education.
